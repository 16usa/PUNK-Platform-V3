import express from 'express';
import pg from 'pg';

const { Pool } = pg;

const app = express();
app.disable('x-powered-by');

const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  max: 5,
  connectionTimeoutMillis: 5000,
  idleTimeoutMillis: 30000
});

// PUNK CORE API V1 — read-only token registry.

app.get('/api/tokens', async (req, res) => {
  try {
    const result = await pool.query(
      `SELECT token_id, name, ticker, description,
              image_url, creator_id, total_supply,
              status, created_at
       FROM punk_tokens
       WHERE status = 'active'
       ORDER BY created_at DESC
       LIMIT 100`
    );

    res.json({
      success: true,
      tokens: result.rows
    });
  } catch (error) {
    console.error('Token list query failed:', error.message);
    res.status(503).json({
      success: false,
      error: 'Token registry unavailable'
    });
  }
});

app.get('/api/tokens/:id', async (req, res) => {
  try {
    const { id } = req.params;

    if (!/^PUNK-[A-Z0-9]{6,24}$/.test(id)) {
      return res.status(400).json({
        success: false,
        error: 'Invalid token ID'
      });
    }

    const result = await pool.query(
      `SELECT token_id, name, ticker, description,
              image_url, creator_id, total_supply,
              status, created_at
       FROM punk_tokens
       WHERE token_id = $1 AND status = 'active'
       LIMIT 1`,
      [id]
    );

    if (!result.rows.length) {
      return res.status(404).json({
        success: false,
        error: 'Token not found'
      });
    }

    res.json({
      success: true,
      token: result.rows[0]
    });
  } catch (error) {
    console.error('Token detail query failed:', error.message);
    res.status(503).json({
      success: false,
      error: 'Token registry unavailable'
    });
  }
});

app.use(express.static('public'));

app.get('/health', async (_req, res) => {
  try {
    await pool.query('SELECT 1');
    res.json({
      ok: true,
      version: '3.1',
      mode: 'punk-core',
      database: 'connected'
    });
  } catch {
    res.status(503).json({
      ok: false,
      database: 'unavailable'
    });
  }
});

const port = Number(process.env.PORT) || 3000;

app.listen(port, '0.0.0.0', () => {
  console.log('PUNK CORE API V1 listening on ' + port);
});
